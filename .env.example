# Copy this file to ".env" and fill in your local values.

# --- DATABASE_URL: pick ONE of these ---
#
# Option 1 (no install): use your free Neon database for local dev too.
# Copy the connection string from the Neon dashboard. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option 2: a local PostgreSQL install.
#   After: createdb purim_platform
DATABASE_URL=postgresql://localhost:5432/purim_platform

# Port the backend listens on (frontend dev server proxies /api here).
PORT=3001

NODE_ENV=development

# SSL is auto-enabled for hosted databases and off for localhost.
# Set to "true" or "false" only to override that.
# PGSSL=true
